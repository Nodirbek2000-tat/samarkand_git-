DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=yangisamarqand.uz
FRONTEND_ORIGINS=https://yangisamarqand.uz
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=change-me-strong
NEXT_REVALIDATE_URL=http://127.0.0.1:3000/internal/revalidate
NEXT_REVALIDATE_SECRET=change-me
# PostgreSQL (optional; SQLite is used when POSTGRES_DB is empty)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Telegram bot — separate project ../samarkand_bot; put the same BOT_API_SECRET into its .env
BOT_API_SECRET=change-me-long-random-string
TELEGRAM_LOGIN_CODE_TTL=300
TELEGRAM_CODE_COOLDOWN=30
