# Backend — serverdagi .env (GitHub ga yuklanmaydi). Nusxa:  cp server.env.example .env
# Maxfiy qatorlar uchun:  openssl rand -hex 32

DJANGO_SECRET_KEY=

# Hozircha domen/SSL yo‘q — sayt http://173.249.39.129 orqali ochiladi.
# Domen va SSL ishlagach: DJANGO_HTTPS=true qiling (qolgan ikki qatorda domen allaqachon bor).
DJANGO_HTTPS=false
DJANGO_ALLOWED_HOSTS=173.249.39.129,mentadbirkor.uz,www.mentadbirkor.uz,backend,localhost,127.0.0.1
FRONTEND_ORIGINS=http://173.249.39.129,https://mentadbirkor.uz,https://www.mentadbirkor.uz

# birinchi ishga tushishda shu login/parol bilan administrator yaratiladi
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=

POSTGRES_DB=mentadbirkor
POSTGRES_USER=mentadbirkor
POSTGRES_PASSWORD=

# frontend .env dagi NEXT_REVALIDATE_SECRET bilan AYNAN bir xil
NEXT_REVALIDATE_SECRET=
# bot .env dagi BOT_API_SECRET bilan AYNAN bir xil
BOT_API_SECRET=
