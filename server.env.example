# Backend — serverdagi .env (GitHub ga yuklanmaydi). Nusxa:  cp server.env.example .env
# Maxfiy qatorlar uchun:  openssl rand -hex 32

DJANGO_SECRET_KEY=

# Sayt faqat https://mentadbirkor.uz da. "backend" — Next.js va bot ichki tarmoqdan shu nom bilan murojaat qiladi,
# localhost — konteynerning o‘z tekshiruvi (healthcheck) uchun.
DJANGO_HTTPS=true
DJANGO_ALLOWED_HOSTS=mentadbirkor.uz,www.mentadbirkor.uz,backend,localhost,127.0.0.1
FRONTEND_ORIGINS=https://mentadbirkor.uz,https://www.mentadbirkor.uz

# birinchi ishga tushishda shu login/parol bilan administrator yaratiladi
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=

POSTGRES_DB=mentadbirkor
POSTGRES_USER=mentadbirkor
POSTGRES_PASSWORD=

# frontend .env dagi NEXT_REVALIDATE_SECRET bilan AYNAN bir xil
NEXT_REVALIDATE_SECRET=
# bot .env dagi BOT_API_SECRET bilan AYNAN bir xil
BOT_API_SECRET=
